# Copy this to .env for local testing, or set these as real environment
# variables in your hosting provider (e.g. Vercel → Settings → Environment
# Variables) when going live.

# LOCAL TESTING (SQLite — no setup required):
# DATABASE_URL="file:./dev.db"
#
# GOING LIVE (Postgres — required, since Vercel's serverless functions
# don't have a persistent local disk for a SQLite file to live on):
# 1. Create a free Postgres database at supabase.com or neon.tech (both
#    have a free tier that's more than enough for testing/launch).
# 2. Also change `provider = "sqlite"` to `provider = "postgresql"` in
#    prisma/schema.prisma.
# 3. Set DATABASE_URL to the connection string they give you, e.g.:
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# A long, random secret used to sign session tokens. Generate a real one
# with: openssl rand -base64 32
# NEVER reuse the placeholder value from .env for anything real.
SESSION_SECRET="replace-this-with-a-real-random-secret"

# Get this from https://aistudio.google.com/apikey once you're ready to
# connect real Gemini generation. Until it's set, lib/ai-provider.ts falls
# back to the mock generator automatically — the app still works, it just
# won't produce real AI output.
GEMINI_API_KEY=
